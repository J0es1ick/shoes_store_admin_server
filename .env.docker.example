# Copy to .env.docker and replace both passwords before starting.
DB_USER=step
DB_NAME=step
DB_PASSWORD=choose-a-local-database-password
STORE_ADMIN_EMAIL=admin@step.local
STORE_ADMIN_PASSWORD=choose-a-local-admin-password
WEB_PORT=8080
STORE_ORIGIN=http://localhost:8080
# false is for local HTTP only; set true when serving over HTTPS.
STORE_COOKIE_SECURE=false
STORE_SEED=true
CLIENT_PATH=../shoes_store_client
# First three IPv4 octets of the dedicated Nginx/API network.
# Change together through this value if 172.30.0.0/24 overlaps another network.
PROXY_NETWORK_PREFIX=172.30.0
